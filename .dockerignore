# Dependencies
node_modules
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# Production builds
.next/
out/
dist/
build/

# Environment variables
.env*.local
.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local task / agent metadata (not needed in image; shrinks build context)
.tasks/
.cursor/

# Git
.git/
.gitignore

# Docker (compose + Dockerfiles are not needed in the image; entrypoints live under docker/ and are copied explicitly)
src/**/Dockerfile*
docker/docker-compose*.yml
.dockerignore

# Test coverage
coverage/
.nyc_output

# Temporary folders
tmp/
temp/

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Workspaces directory (will be created in container)
workspaces/

# Tests
tests/
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Documentation (keep docs/ for runtime doc pages)
README.md
CLAUDE.md

# CI/CD
.github/
.gitlab-ci.yml

# Type checking cache
*.tsbuildinfo 