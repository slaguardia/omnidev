# ============================================================================
# Omnidev - Environment Variables
# ============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION (Required)
# ----------------------------------------------------------------------------
# NextAuth requires a secret for JWT token signing and encryption
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# GIT PROVIDER TOKENS (At least one recommended)
# ----------------------------------------------------------------------------
# GitHub personal access token
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitLab personal access token
# Create at: https://gitlab.com/-/profile/personal_access_tokens
# Required scopes: api, read_repository, write_repository
GITLAB_TOKEN=

# GitLab instance URL (only for self-hosted GitLab)
GITLAB_URL=

# ----------------------------------------------------------------------------
# FIRST USER SETUP
# ----------------------------------------------------------------------------
# Token required for first user registration (security measure)
# Generate with: openssl rand -hex 32
INITIAL_SIGNUP_TOKEN=

# ----------------------------------------------------------------------------
# API CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Maximum number of API requests per hour per client
API_RATE_LIMIT=100

# Comma-separated list of allowed IP addresses for API access
# Use '*' to allow all IPs (not recommended for production)
ALLOWED_IPS=*

# API keys for external clients (comma-separated)
# Generate with: openssl rand -hex 32
VALID_API_KEYS=

# Admin API key with elevated privileges
ADMIN_API_KEY=

# ----------------------------------------------------------------------------
# CLAUDE API (Optional)
# ----------------------------------------------------------------------------
# Anthropic API key for Claude Code integration
# Get your key from: https://console.anthropic.com/
# Note: Can also be configured through the UI settings
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# RAILWAY / SHOWCASE MODE (Build-time only)
# ----------------------------------------------------------------------------
# Set to 'true' in Railway dashboard for showcase deployments
# This is a BUILD-TIME variable - must be set before docker build
# For local showcase: use docker-compose.showcase.yml instead
# NEXT_PUBLIC_SHOWCASE_MODE=false

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit your .env file to version control
# 2. Use strong, randomly generated keys (minimum 32 characters)
# 3. Rotate API keys and secrets regularly
# 4. Use different secrets for development and production
# 5. Enable IP whitelisting in production environments
#
# To generate secure random keys:
#   openssl rand -base64 32    # For NEXTAUTH_SECRET
#   openssl rand -hex 32       # For API keys and tokens
# ============================================================================
