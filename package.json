{
  "name": "omnidev",
  "version": "1.0.0",
  "private": true,
  "description": "Omnidev monorepo (web + worker + shared)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @omnidev/web dev",
    "build": "pnpm --filter @omnidev/web build",
    "start": "pnpm --filter @omnidev/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "pnpm exec tsc --noEmit -p src/web/tsconfig.json && pnpm exec tsc --noEmit -p src/shared/tsconfig.json && pnpm exec tsc --noEmit -p src/worker/tsconfig.json && pnpm typecheck:cli",
    "typecheck:cli": "pnpm --filter omnidev exec tsc --noEmit",
    "build:cli": "pnpm --filter omnidev build",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "depcheck": "depcheck --ignores=highlight.js,@react-types/shared,@vitest/coverage-v8,autoprefixer,postcss,tsx,esbuild,next-auth,@playwright/test,@tailwindcss/typography,@types/better-sqlite3,@types/qrcode,@types/react,tailwind-variants,tailwindcss,@prisma/client",
    "lint:all": "pnpm lint && pnpm prettier && pnpm depcheck",
    "lint:all:fix": "pnpm lint:fix && pnpm prettier:fix && pnpm depcheck",
    "clean:workspaces": "ts-node scripts/cleanup-workspaces.ts",
    "playwright:mcp": "npx @playwright/mcp@latest --browser chromium --port 8931",
    "pre-deploy": "sh scripts/pre-deploy.sh",
    "deploy": "sh scripts/deploy.sh",
    "deploy:web": "railway up --service web --detach",
    "deploy:worker": "railway up --service worker --detach",
    "docker:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml build app",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up -d app",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f app",
    "docker:prod:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml down",
    "docker:dev:build": "docker compose -f docker/docker-compose.yml build app",
    "docker:dev:up": "docker compose -f docker/docker-compose.yml up app",
    "setup:hooks": "cp scripts/check-secrets.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "check:secrets": "bash scripts/check-secrets.sh",
    "security:audit": "pnpm audit",
    "security:integration": "vitest run tests/integration/auth.test.ts tests/integration/api-routes.test.ts",
    "security:check": "pnpm security:integration && pnpm security:audit",
    "worker": "tsx src/worker/src/index.ts",
    "worker:build": "tsup --config src/worker/tsup.config.ts",
    "worker:start": "node dist/index.cjs",
    "ralph": "tsx packages/omnidev-cli/src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "15.3.1",
    "@playwright/test": "^1.58.2",
    "@prisma/client": "^5.22.0",
    "@react-types/shared": "3.29.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "10.4.21",
    "depcheck": "^1.4.7",
    "eslint": "9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-validate-filename": "^1.0.0",
    "globals": "^16.0.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prisma": "^5.22.0",
    "tailwind-variants": "0.3.0",
    "tailwindcss": "3.4.16",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "better-sqlite3",
      "sharp"
    ]
  }
}
